# Handyman backend settings. Copy to backend/.env (or the repo-root .env)
# for local development and fill in. Never commit a real .env.
# In production (Modal) they come from the Modal secret "handyman"
# (Modal dashboard > Secrets); backend/modal_app.py itself sets
# HANDYMAN_ENV=production and SPARK_MODEL=prod. Nothing secret lives here.
# The server checks them at startup and stops with a message naming
# anything missing (backend/config.py).

# --- Meta Model API ------------------------------------------------------
# REQUIRED. Gateway base URL for Muse Spark, SAM 3.1, Muse Wonder and Muse
# Image. From your Meta developer console. Format: https://host/v1
MUSE_SPARK_API_URL=
# REQUIRED. SECRET. API key for that gateway, from the same console.
# Production: key in the Modal secret "handyman".
MUSE_SPARK_API_KEY=
# Optional (default local). Which Muse Spark model to call:
#   local = muse-spark-1.3-contributor (cheap, for development)
#   prod  = muse-spark-1.3 (latency targets, eval, demo)
# A raw model id also works. Production is always "prod" (enforced).
SPARK_MODEL=local
# Optional. Override the SAM 3.1 path on the gateway. Default: /responses
MUSE_SAM_PATH=
# Optional. Server-side muse-voice-transcribe endpoint, if you have one.
# Unset: the app uses the browser's own speech recognition.
MUSE_TRANSCRIBE_URL=

# --- Google Places (call a pro) -----------------------------------------
# Optional (recommended). SECRET. Places API (New) key, server-side only.
# Google Cloud console > APIs & Services > Credentials > Create API key,
# restricted to "Places API (New)". Format: AIza... (39 characters).
# Unset: "call a pro" shows a "Find nearby" Google Maps button instead.
# Production: key in the Modal secret "handyman".
GOOGLE_PLACES_API_KEY=

# --- Production guard ----------------------------------------------------
# Optional locally; backend/modal_app.py sets it in production. "production" makes
# PROXY_SECRET and ALLOWED_ORIGINS required and SPARK_MODEL=prod mandatory.
HANDYMAN_ENV=
# REQUIRED in production. SECRET. Shared with Vercel's PROXY_SECRET: the
# Vercel middleware sends it with every /api call and the backend rejects
# calls without it. 64 hex characters (generate: openssl rand -hex 32).
# Production: key in the Modal secret "handyman". Leave empty
# locally (no check).
PROXY_SECRET=
# REQUIRED in production (Modal secret "handyman"). Comma-separated browser origins allowed by CORS,
# e.g. https://handy-man.vercel.app. Empty locally = any origin.
ALLOWED_ORIGINS=

# --- Limits (protect the bill; per visitor IP, per instance) ------------
# Optional. 0 disables a limit. Modal runs at most 3 containers, so a
# visitor can get up to 3x these numbers at most.
# Fixes a visitor can start per hour (a "first look" at a new photo).
RATE_TURNS_PER_HOUR=20
# All /api requests per visitor per hour (a fix is ~10-25 requests).
RATE_REQUESTS_PER_HOUR=800
# "Call a pro" lookups (billed by Google) per browser tab per day.
PLACES_PER_SESSION=3
# ...and per visitor IP per day.
PLACES_PER_IP_PER_DAY=15
