# Copy to .env and fill in. Never commit .env with real values.
# One hosted Meta gateway serves both sandbox models:
MUSE_SPARK_API_URL=
MUSE_SPARK_API_KEY=
# Spark model: local = muse-spark-1.3-contributor (cheap, for development),
# prod = muse-spark-1.3 (latency targets, eval, demo). A raw model id also
# works; GET {MUSE_SPARK_API_URL}/models lists what your key can use.
SPARK_MODEL=local
# Optional: override the SAM 3.1 path (default: /responses).
MUSE_SAM_PATH=
