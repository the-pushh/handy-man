# Copy to .env and fill in. Never commit .env with real values.
# One hosted Meta gateway serves both sandbox models:
MUSE_SPARK_API_URL=
MUSE_SPARK_API_KEY=
# Optional: override the Spark model (default: muse-spark-1.3).
# GET {MUSE_SPARK_API_URL}/models lists what your key can use.
MUSE_SPARK_MODEL=
# Optional: override the SAM 3.1 path (default: /responses).
MUSE_SAM_PATH=
