# Handyman frontend settings. Paste these into Vercel:
#   Project > Settings > Environment Variables (Production).
# Both are server-side only (no NEXT_PUBLIC_ prefix): middleware.ts reads
# them on Vercel's side, and neither is ever sent to the browser.
# Locally (npm run dev) leave both unset: /api/* goes to the backend on
# http://127.0.0.1:8000 and the dev-only backend picker handles tunnels.

# REQUIRED in production. The Cloud Run backend URL, no trailing slash.
# From the deploy run's summary on GitHub, or:
#   gcloud run services describe handyman-backend --region asia-south1 --format='value(status.url)'
# Format: https://handyman-backend-xxxxxxxxxx-el.a.run.app
BACKEND_URL=

# REQUIRED in production. SECRET. Must equal the backend's PROXY_SECRET:
#   gcloud secrets versions access latest --secret=handyman-proxy-secret
# 64 hex characters. Mark it "Sensitive" in Vercel.
PROXY_SECRET=

# Optional, local development only (ignored in production builds): send
# /api to this backend instead of the same host's port 8000.
NEXT_PUBLIC_API_BASE=
